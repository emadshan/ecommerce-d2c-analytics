Orders = DISTINCTCOUNT(Orders[order_id])
Delivered Orders = CALCULATE([Orders], Orders[order_status] = "delivered")
Delivered Rate = DIVIDE([Delivered Orders], [Orders])
Gross Order Value = SUM(Orders[order_value_inr])
AOV = DIVIDE([Gross Order Value], [Orders])
RTO Orders = CALCULATE([Orders], Orders[delivery_outcome] = "RTO")
RTO Rate = DIVIDE([RTO Orders], [Orders])
Net Sales = SUM(Orders[net_sales_inr])
Contribution = SUM(Orders[contribution_inr])
Contribution Margin % = DIVIDE([Contribution], [Net Sales])
Marketing Spend = SUM(Spend[spend_inr])
ROAS = DIVIDE([Net Sales], [Marketing Spend])
CAC = DIVIDE([Marketing Spend], DISTINCTCOUNT(Orders[customer_id]))
Return Amount = SUM(Returns[refund_amount_inr])
